# Copy to deploy/.env and edit. Read by docker compose (--env-file deploy/.env).
AIMS_HOST=aims.leonmgarcia.com          # the console's own host name; its DNS A record must point at this machine
AIMS_ACCESS_TOKEN=change-me               # python -c 'import secrets; print(secrets.token_urlsafe(24))'; the static page is built with --token set to the same value
AIMS_REPO=/srv/AIMS                     # clone of the AIMS repository (prompts/, templates/, mcpServer/)
AIMS_EXAMPLES=/srv/aims-examples        # the team's examples: VbgScans/, GridSpectra/, SampleLocatingImages/ (23 MB, not in the public repository)
AIMS_ORIGINS=https://leonmgarcia.com    # pages allowed to call the API (comma-separated)
AIMS_MAX_CONCURRENT=4                   # live runs at once; each holds a simulator and an agent process
AIMS_MAX_TURNS_CAP=80
AIMS_WALL_LIMIT_MIN=45
AIMS_CPUS=4
AIMS_MEMORY=8g

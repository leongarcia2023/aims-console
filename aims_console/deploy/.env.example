# Copy to deploy/.env and edit (bootstrap.sh writes this file for you). Read by docker compose (--env-file deploy/.env).
AIMS_HOST=aims.leonmgarcia.com          # the console's own host name; its DNS A record must point at this machine
AIMS_ACCESS_TOKEN=change-me               # python -c 'import secrets; print(secrets.token_urlsafe(24))'; the static page is built with --token set to the same value
AIMS_ORIGINS=https://leonmgarcia.com    # pages allowed to call the API (comma-separated)
AIMS_HOSTED=0                           # 1: runs use ANTHROPIC_API_KEY below (the authors pay, within the caps); 0: every run brings a key
ANTHROPIC_API_KEY=                      # hosted mode only; keep this file mode 600 and give the key a spend limit in the Anthropic Console
AIMS_MAX_CONCURRENT=3                   # live runs at once; each holds a simulator and an agent process
AIMS_MAX_TURNS_CAP=80
AIMS_WALL_LIMIT_MIN=45
AIMS_CPUS=2
AIMS_MEMORY=3g
